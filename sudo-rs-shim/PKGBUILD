pkgname=sudo-rs-shim
pkgver=1
pkgrel=6
pkgdesc="Symlink to provide sudo with sudo-rs"
arch=('any')
depends=('pambase' 'sudo-rs')
_replaces=('sudo')
provides=(${_replaces[*]})
conflicts=(${_replaces[*]})
source=(pam-sudo-conf sudoers-rs)
b2sums=(SKIP SKIP)

_pamconf=etc/pam.d/sudo
backup=("$_pamconf" "${_pamconf}-i")

package() {
  cd "$pkgdir"
  install -dm755 usr/bin
  install -dm755 etc
  install -dm750 etc/sudoers.d

  cd usr/bin
  ln -sf sudo-rs sudo
  ln -sf sudoedit-rs sudoedit
  ln -sf visudo-rs visudo
  cd -

  install -Dm644 "$srcdir/pam-sudo-conf" "$_pamconf"
  install -Dm644 "$srcdir/pam-sudo-conf" "${_pamconf}-i"
  install -Dm440 "$srcdir/sudoers-rs" etc/sudoers-rs
}
